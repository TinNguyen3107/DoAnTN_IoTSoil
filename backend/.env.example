PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=soil_iot_db
# Set true for TiDB Cloud / managed MySQL that requires TLS
DB_SSL=false

# Security & Tokens
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h